rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{document} {
      allow create: if request.auth.uid == document;
      allow read: if request.auth.uid == document;
      allow write: if request.auth.uid == document;
      allow delete: if request.auth.uid == document;
    }

    match /profiles/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if resource.data.usersRef == /databases/$(database)/documents/users/$(request.auth.uid);
      allow delete: if false;
    }

    match /goals/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if resource.data.createdBy == /databases/$(database)/documents/users/$(request.auth.uid);
      allow delete: if false;
    }

    match /tasks/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if resource.data.createdBy == /databases/$(database)/documents/users/$(request.auth.uid);
      allow delete: if false;
    }

    match /tasks/{parent}/taskActivities/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if resource.data.createdBy == /databases/$(database)/documents/users/$(request.auth.uid);
      allow delete: if false;
    }

    match /{path=**}/taskActivities/{document} {
      allow read: if request.auth != null;
    }


    match /threads/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid);
      allow delete: if false;
    }

    match /threads/{parent}/messages/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if resource.data.createdBy == /databases/$(database)/documents/users/$(request.auth.uid);
      allow delete: if false;
    }

    match /{path=**}/messages/{document} {
      allow read: if request.auth != null;
    }


    match /notes/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if resource.data.createdBy == /databases/$(database)/documents/users/$(request.auth.uid);
      allow delete: if false;
    }

    match /notifications/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if resource.data.userRef == /databases/$(database)/documents/users/$(request.auth.uid);
      allow delete: if false;
    }

    match /test/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if false;
    }
  }
}
